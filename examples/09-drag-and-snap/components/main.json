      },
      "ui": { "x": 619, "y": 246 }
    },
    "finger": {
      "type": "pulse",
      "name": "Finger Down or Up",
      "inputs": { "on": { "link": "pip_gesture.down" } },
      "ui": { "x": 309, "y": 246 }
    },
    "finger_position": {
      "type": "add",
      "name": "Position Under Finger",
      "typeParam": "point",
      "inputCount": 2,
      "inputs": {
        "value1": { "link": "grab_position.output" },
        "value2": { "link": "pip_gesture.translation" }
      },
      "ui": { "x": 879, "y": 40 }
    },
    "fling_corner": {
      "type": "snap",
      "name": "Nearest Corner After Fling",
      "typeParam": "point",
      "inputs": {
        "deceleration": "normal",
        "mode": "points",
        "points": { "link": "corners.loop" },
        "value": { "link": "pip_last_frame.output" },
        "velocity": { "link": "pip_gesture.velocity" }
      },
      "ui": { "x": 309, "y": 558 }
    },
    "grab_position": {
      "type": "sampleAndHold",
      "name": "Position at Grab",
      "typeParam": "point",
      "inputs": {
        "sample": { "link": "pip_idle.output" },
        "value": { "link": "pip_last_frame.output" }
      },
      "ui": { "x": 619, "y": 40 }
    },
    "pip_gesture": {
      "type": "gesture",
      "name": "Drag Self View",
      "inputs": { "layer": { "layer": "pip" } },
      "ui": { "x": 40, "y": 40 }
    },
    "pip_idle": {
      "type": "not",
      "name": "Not Dragging",
      "inputs": { "value": { "link": "pip_gesture.down" } },
      "ui": { "x": 309, "y": 40 }
    },
    "pip_last_frame": {
      "type": "delay1",
      "name": "Position Last Frame",
      "typeParam": "point",
      "inputs": { "value": { "link": "pip_spring.output" } },
      "ui": { "x": 1659, "y": 40 }
    },
    "pip_lift": {
      "type": "transition",
      "name": "Lift While Held",
      "typeParam": "number",
      "inputs": {
        "end": 1.06,
        "progress": { "link": "pip_press.output" },
        "start": 1
      },
      "ui": { "x": 619, "y": 408 }
    },
    "pip_press": {
      "type": "popAnimation",
      "name": "Press Spring",
      "typeParam": "number",
      "inputs": {
        "bounciness": 0,
        "number": { "link": "pip_gesture.down" },
        "speed": 20
      },
      "ui": { "x": 309, "y": 408 }
    },
    "pip_spring": {
      "type": "springAnimation",
      "name": "Self View Spring",
      "typeParam": "point",
      "inputs": {
        "friction": 22,
        "gestureActive": { "link": "pip_gesture.down" },
        "gestureVelocity": { "link": "pip_gesture.velocity" },
        "number": { "link": "pip_target.output" },
        "tension": 220
      },
      "ui": { "x": 1399, "y": 40 }
    },
    "pip_target": {
      "type": "ifElse",
      "name": "Finger or Corner",
      "typeParam": "point",
      "inputs": {
        "condition": { "link": "pip_gesture.down" },
        "ifFalse": { "link": "corner_position.output" },
        "ifTrue": { "link": "finger_position.output" }
      },
      "ui": { "x": 1139, "y": 40 }
    }
  },
