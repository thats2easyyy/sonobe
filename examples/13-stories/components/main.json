      "inputs": {
        "index": { "link": "stories.index" },
        "progress": { "link": "story_timer.progress" },
        "story": { "link": "current_story.count" }
      },
      "settings": { "expression": "clamp(story + progress - index, 0, 1)" },
      "ui": { "x": 1667, "y": 40 }
    },
    "segment_grid": {
      "type": "gridLayout",
      "name": "Bar Positions",
      "inputs": {
        "columns": 3,
