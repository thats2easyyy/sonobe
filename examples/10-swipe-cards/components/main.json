        "start": 1
      },
      "ui": { "x": 1860, "y": 40 }
    },
    "card_side": {
      "type": "optionSwitch",
      "name": "Swiped Which Way",
      "inputCount": 2,
      "inputs": {
        "setTo0": { "link": "card_swipe.swipedLeft" },
        "setTo1": { "link": "card_swipe.swipedRight" }
      },
      "ui": { "x": 300, "y": 40 }
    },
    "card_spring": {
      "type": "springAnimation",
      "name": "Card Spring",
      "typeParam": "number",
      "inputs": {
        "friction": 20,
        "gestureActive": { "link": "card_gesture.down" },
        "gestureVelocity": { "link": "finger_speed.x" },
        "number": { "link": "card_target.output" },
        "tension": 180
      },
      "ui": { "x": 1340, "y": 190 }
    },
    "card_swipe": {
      "type": "swipe",
      "name": "Swipe Card",
      "inputs": {
        "axis": "horizontal",
        "layer": { "layer": "card" },
        "minDistance": 120,
        "minVelocity": 800
      },
      "ui": { "x": 40, "y": 190 }
    },
    "card_target": {
      "type": "ifElse",
      "name": "Finger or Resting X",
      "typeParam": "number",
      "inputs": {
        "condition": { "link": "card_gesture.down" },
        "ifFalse": { "link": "resting_x.output" },
        "ifTrue": { "link": "finger_offset.x" }
      },
      "ui": { "x": 1080, "y": 340 }
    },
    "card_titles": {
      "type": "loopBuilder",
      "name": "Dish Names",
      "typeParam": "text",
      "inputCount": 3,
      "inputs": { "item0": "Lemon ricotta pasta", "item1": "Charred corn tacos", "item2": "Miso ramen" },
      "ui": { "x": 40, "y": 940 }
    },
    "card_x": {
      "type": "add",
      "name": "Card X",
      "typeParam": "number",
      "inputCount": 2,
      "inputs": {
        "value1": 201,
        "value2": { "link": "card_spring.output" }
      },
      "ui": { "x": 1600, "y": 190 }
    },
    "card_y": {
      "type": "transition",
      "name": "Card Y",
      "typeParam": "number",
      "inputs": {
        "end": 458,
        "progress": { "link": "depth_spring.output" },
        "start": 440
      },
      "ui": { "x": 1860, "y": 190 }
    },
    "cards": {
      "type": "loop",
      "name": "Cards",
      "inputs": { "count": 3 },
      "ui": { "x": 40, "y": 40 }
    },
    "cards_gone": {
      "type": "loopSum",
      "name": "Cards Gone",
      "typeParam": "number",
      "inputs": { "loop": { "link": "card_gone.on" } },
      "ui": { "x": 560, "y": 190 }
    },
    "depth_in_deck": {
      "type": "clamp",
      "name": "Depth in Deck",
      "typeParam": "number",
      "inputs": {
        "max": 2,
        "min": 0,
        "value": { "link": "card_depth.output" }
      },
      "ui": { "x": 1340, "y": 40 }
    },
    "depth_spring": {
      "type": "popAnimation",
      "name": "Depth Spring",
      "typeParam": "number",
      "inputs": {
        "bounciness": 4,
        "number": { "link": "depth_in_deck.output" },
        "speed": 12
      },
      "ui": { "x": 1600, "y": 40 }
    },
    "finger_offset": {
      "type": "pointUnpack",
      "name": "Finger Offset",
      "inputs": { "value": { "link": "card_gesture.translation" } },
      "ui": { "x": 300, "y": 340 }
    },
    "finger_speed": {
      "type": "pointUnpack",
      "name": "Finger Speed",
      "inputs": { "value": { "link": "card_gesture.velocity" } },
      "ui": { "x": 300, "y": 490 }
    },
    "fly_out_x": {
      "type": "optionPicker",
      "name": "Fly-Out X",
      "typeParam": "number",
      "inputCount": 2,
      "inputs": {
        "option": { "link": "card_side.option" },
        "option0": -600,
        "option1": 600
      },
      "ui": { "x": 560, "y": 40 }
    },
    "is_top": {
      "type": "equals",
      "name": "Is Top Card",
      "typeParam": "number",
      "inputs": {
        "value1": { "link": "cards.index" },
        "value2": { "link": "top_index.output" }
      },
      "ui": { "x": 1080, "y": 40 }
    },
    "like_opacity": {
      "type": "progress",
      "name": "Save Badge Opacity",
      "inputs": {
        "clampToRange": true,
        "end": 120,
        "start": 20,
        "value": { "link": "card_spring.output" }
      },
      "ui": { "x": 1600, "y": 490 }
    },
    "nope_opacity": {
      "type": "progress",
      "name": "Skip Badge Opacity",
      "inputs": {
        "clampToRange": true,
        "end": -120,
        "start": -20,
        "value": { "link": "card_spring.output" }
      },
      "ui": { "x": 1600, "y": 640 }
    },
    "resting_x": {
      "type": "ifElse",
      "name": "Resting X",
      "typeParam": "number",
      "inputs": {
        "condition": { "link": "card_gone.on" },
        "ifFalse": 0,
        "ifTrue": { "link": "fly_out_x.output" }
      },
      "ui": { "x": 820, "y": 40 }
    },
    "tap_start_over": {
      "type": "interaction",
      "name": "Tap Start Over",
      "inputs": { "layer": { "layer": "start_over" } },
      "ui": { "x": 40, "y": 340 }
    },
    "top_index": {
      "type": "subtract",
      "name": "Top Card",
      "typeParam": "number",
      "inputCount": 2,
      "inputs": {
        "value1": 2,
        "value2": { "link": "cards_gone.sum" }
      },
      "ui": { "x": 820, "y": 190 }
    }
