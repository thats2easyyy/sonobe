  "patches": {
    "content_position": {
      "type": "point",
      "name": "Content Position",
      "inputs": {
        "x": 0,
        "y": { "link": "content_y.output" }
      },
      "ui": { "x": 1860, "y": 40 }
    },
    "content_y": {
      "type": "add",
      "name": "Content Y",
      "typeParam": "number",
      "inputCount": 2,
      "inputs": {
        "value1": { "link": "feed_scroll.y" },
        "value2": { "link": "spacer_height.output" }
      },
      "ui": { "x": 1600, "y": 40 }
    },
    "feed_scroll": {
      "type": "scroll",
      "name": "Scroll Feed",
      "inputs": {
        "layer": { "layer": "content" },
        "scrollY": "free"
      },
      "ui": { "x": 40, "y": 40 }
    },
    "has_refreshed": {
      "type": "greaterThan",
      "name": "Has Refreshed",
      "typeParam": "number",
      "inputCount": 2,
      "inputs": {
        "value1": { "link": "refresh_count.count" },
        "value2": 0
      },
      "ui": { "x": 560, "y": 190 }
    },
    "not_dragging": {
      "type": "not",
      "name": "Not Dragging",
      "inputs": { "value": { "link": "feed_scroll.dragging" } },
      "ui": { "x": 300, "y": 190 }
    },
    "pull_amount": {
      "type": "progress",
      "name": "Pull Amount",
      "inputs": {
        "clampToRange": true,
        "end": 64,
        "start": 0,
        "value": { "link": "feed_scroll.y" }
      },
      "ui": { "x": 300, "y": 40 }
    },
    "pulled_far": {
      "type": "greaterThanOrEqual",
      "name": "Pulled Far Enough",
      "typeParam": "number",
      "inputCount": 2,
      "inputs": {
        "value1": { "link": "feed_scroll.y" },
        "value2": 64
      },
      "ui": { "x": 300, "y": 340 }
    },
    "refresh_count": {
      "type": "counter",
      "name": "Refresh Count",
      "inputs": { "increase": { "link": "refresh_timer.finished" } },
      "ui": { "x": 300, "y": 490 }
    },
    "refresh_timer": {
      "type": "wait",
      "name": "Pretend Network Request",
      "inputs": {
        "duration": 1.6,
        "start": { "link": "refreshing.on" }
      },
      "ui": { "x": 40, "y": 190 }
    },
    "refreshing": {
      "type": "switch",
      "name": "Refreshing",
      "inputs": {
        "turnOff": { "link": "refresh_timer.finished" },
        "turnOn": { "link": "start_refresh.output" }
      },
      "ui": { "x": 820, "y": 40 }
    },
    "spacer_height": {
      "type": "transition",
      "name": "Spacer Height",
      "typeParam": "number",
      "inputs": {
        "end": 64,
        "progress": { "link": "spacer_spring.output" },
        "start": 0
      },
      "ui": { "x": 1340, "y": 40 }
    },
    "spacer_spring": {
      "type": "popAnimation",
      "name": "Spacer Spring",
      "typeParam": "number",
      "inputs": {
        "bounciness": 0,
        "number": { "link": "refreshing.on" },
        "speed": 14
      },
      "ui": { "x": 1080, "y": 40 }
    },
    "spin": {
      "type": "repeatingAnimation",
      "name": "Spin",
      "inputs": {
        "curve": "linear",
        "duration": 0.9,
        "enabled": { "link": "refreshing.on" },
        "mirrored": false
      },
      "ui": { "x": 1080, "y": 190 }
    },
    "spinner_arc": {
      "type": "transition",
      "name": "Spinner Arc",
      "typeParam": "number",
      "inputs": {
        "end": 0.8,
        "progress": { "link": "spinner_reveal.output" },
        "start": 0
      },
      "ui": { "x": 1600, "y": 190 }
    },
    "spinner_reveal": {
      "type": "max",
      "name": "Spinner Reveal",
      "typeParam": "number",
      "inputCount": 2,
      "inputs": {
        "value1": { "link": "pull_amount.progress" },
        "value2": { "link": "spacer_spring.output" }
      },
      "ui": { "x": 1340, "y": 190 }
    },
    "spinner_rotation": {
      "type": "transition",
      "name": "Spinner Rotation",
      "typeParam": "number",
      "inputs": {
        "end": 360,
        "progress": { "link": "spin.progress" },
        "start": 0
      },
      "ui": { "x": 1340, "y": 340 }
    },
    "spinner_shape": {
      "type": "circleShape",
      "name": "Spinner Circle",
      "inputs": {
        "position": [14, 14],
        "radius": 11
      },
      "ui": { "x": 40, "y": 790 }
    },
    "start_refresh": {
      "type": "and",
      "name": "Let Go Past Threshold",
      "inputCount": 2,
      "inputs": {
        "value1": { "link": "not_dragging.output" },
        "value2": { "link": "pulled_far.output" }
      },
      "ui": { "x": 560, "y": 40 }
    },
    "status_text": {
      "type": "ifElse",
      "name": "Status Text",
      "typeParam": "text",
      "inputs": {
        "condition": { "link": "has_refreshed.output" },
        "ifFalse": "Pull down to refresh",
        "ifTrue": "Updated just now"
      },
      "ui": { "x": 820, "y": 190 }
    }
  },
