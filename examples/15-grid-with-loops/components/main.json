  "patches": {
    "hue": {
      "type": "divide",
      "name": "Hue Step",
      "typeParam": "number",
      "inputCount": 2,
      "inputs": {
        "value1": { "link": "tiles.index" },
        "value2": 12
      },
      "ui": { "x": 300, "y": 190 }
    },
    "intro_spring": {
      "type": "popAnimation",
      "name": "Intro Spring",
      "typeParam": "number",
      "inputs": {
        "bounciness": 6,
        "number": { "link": "tile_shown.output" },
        "speed": 14
      },
      "ui": { "x": 820, "y": 340 }
    },
    "intro_wait": {
      "type": "wait",
      "name": "Short Pause",
      "inputs": {
        "duration": 0.15,
        "start": { "link": "started.started" }
      },
      "ui": { "x": 300, "y": 640 }
    },
    "is_selected": {
      "type": "equals",
      "name": "Is Selected",
      "typeParam": "number",
      "inputs": {
        "value1": { "link": "tiles.index" },
        "value2": { "link": "selected_tile.option" }
      },
      "ui": { "x": 560, "y": 340 }
    },
    "preview_color": {
      "type": "popAnimation",
      "name": "Preview Color",
      "typeParam": "color",
      "inputs": {
        "bounciness": 0,
        "number": { "link": "selected_color.output" },
        "speed": 12
      },
      "ui": { "x": 1080, "y": 190 }
    },
    "preview_hex": {
      "type": "colorToHex",
      "name": "Preview Hex",
      "inputs": { "color": { "link": "selected_color.output" } },
      "ui": { "x": 1080, "y": 340 }
    },
    "ring_width": {
      "type": "transition",
      "name": "Ring Width",
      "typeParam": "number",
      "inputs": {
        "end": 4,
        "progress": { "link": "select_spring.output" },
        "start": 0
      },
      "ui": { "x": 1080, "y": 40 }
    },
    "select_spring": {
      "type": "popAnimation",
      "name": "Select Spring",
      "typeParam": "number",
      "inputs": {
        "bounciness": 4,
        "number": { "link": "is_selected.output" },
        "speed": 16
      },
      "ui": { "x": 820, "y": 40 }
    },
    "selected_color": {
      "type": "loopSelect",
      "name": "Selected Color",
      "typeParam": "color",
      "inputs": {
        "index": { "link": "selected_tile.option" },
        "loop": { "link": "tile_colors.color" }
      },
      "ui": { "x": 820, "y": 190 }
    },
    "selected_tile": {
      "type": "loopOptionSwitch",
      "name": "Selected Tile",
      "inputs": { "select": { "link": "tap_tile.tap" } },
      "ui": { "x": 300, "y": 790 }
    },
    "stagger_delay": {
      "type": "multiply",
      "name": "Stagger Delay",
      "typeParam": "number",
      "inputCount": 2,
      "inputs": {
        "value1": { "link": "tiles.index" },
        "value2": 0.04
      },
      "ui": { "x": 300, "y": 490 }
    },
    "started": {
      "type": "whenPrototypeStarts",
      "name": "Prototype Starts",
      "inputs": {},
      "ui": { "x": 40, "y": 190 }
    },
    "tap_tile": {
      "type": "interaction",
      "name": "Tap Tile",
      "inputs": { "layer": { "layer": "tile" } },
      "ui": { "x": 40, "y": 340 }
    },
    "tile_colors": {
      "type": "hslColor",
      "name": "Tile Color",
      "inputs": {
        "hue": { "link": "hue.output" },
        "lightness": 0.6,
        "saturation": 0.72
      },
      "ui": { "x": 560, "y": 40 }
    },
    "tile_grid": {
      "type": "gridLayout",
      "name": "Tile Grid",
      "inputs": {
        "columns": 3,
        "index": { "link": "tiles.index" },
        "itemHeight": 116,
        "origin": [16, 290],
        "spacing": 10,
        "width": 370
      },
      "ui": { "x": 300, "y": 40 }
    },
    "tile_number": {
      "type": "add",
      "name": "Tile Number",
      "typeParam": "number",
      "inputCount": 2,
      "inputs": {
        "value1": { "link": "tiles.index" },
        "value2": 1
      },
      "ui": { "x": 300, "y": 340 }
    },
    "tile_numbers": {
      "type": "formatNumber",
      "name": "Tile Label",
      "inputs": {
        "minimumDigits": 2,
        "prefix": "#",
        "value": { "link": "tile_number.output" }
      },
      "ui": { "x": 560, "y": 190 }
    },
    "tile_opacity": {
      "type": "progress",
      "name": "Tile Opacity",
      "inputs": {
        "clampToRange": true,
        "end": 0.6,
        "start": 0,
        "value": { "link": "intro_spring.output" }
      },
      "ui": { "x": 1080, "y": 640 }
    },
    "tile_scale": {
      "type": "transition",
      "name": "Tile Scale",
      "typeParam": "number",
      "inputs": {
        "end": 1,
        "progress": { "link": "intro_spring.output" },
        "start": 0.6
      },
      "ui": { "x": 1080, "y": 490 }
    },
    "tile_shown": {
      "type": "delay",
      "name": "Tile Shown",
      "typeParam": "boolean",
      "inputs": {
        "duration": { "link": "stagger_delay.output" },
        "value": { "link": "intro_wait.done" }
      },
      "ui": { "x": 560, "y": 490 }
    },
    "tiles": {
      "type": "loop",
      "name": "Tiles",
      "inputs": { "count": 12 },
      "ui": { "x": 40, "y": 40 }
    }
  },
  "comments": []
}
