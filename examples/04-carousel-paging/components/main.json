  "patches": {
    "dot_color": {
      "type": "transition",
      "name": "Dot Color",
      "typeParam": "color",
      "inputs": {
        "end": "#FFFFFFFF",
        "progress": { "link": "dot_spring.output" },
        "start": "#FFFFFF66"
      },
      "ui": { "x": 1080, "y": 190 }
    },
    "dot_is_current": {
      "type": "equals",
      "name": "Dot Is Current Page",
      "typeParam": "number",
      "inputs": {
        "value1": { "link": "page_dots.index" },
        "value2": { "link": "trips_scroll.pageX" }
      },
      "ui": { "x": 560, "y": 190 }
    },
    "dot_position": {
      "type": "point",
      "name": "Dot Position",
      "inputs": {
        "x": { "link": "dot_x.output" },
        "y": 700
      },
      "ui": { "x": 560, "y": 40 }
    },
    "dot_size": {
      "type": "transition",
      "name": "Dot Size",
      "typeParam": "size",
      "inputs": {
        "end": [22, 8],
        "progress": { "link": "dot_spring.output" },
        "start": [8, 8]
      },
      "ui": { "x": 1080, "y": 40 }
    },
    "dot_spring": {
      "type": "popAnimation",
      "name": "Dot Spring",
      "typeParam": "number",
      "inputs": {
        "bounciness": 0,
        "number": { "link": "dot_is_current.output" },
        "speed": 18
      },
      "ui": { "x": 820, "y": 40 }
    },
    "dot_x": {
      "type": "mathExpression",
      "name": "Dot X",
      "inputs": { "index": { "link": "page_dots.index" } },
      "settings": { "expression": "171 + index * 20" },
      "ui": { "x": 300, "y": 40 }
    },
    "next_page_x": {
      "type": "mathExpression",
      "name": "Next Page X",
      "inputs": { "page": { "link": "trips_scroll.pageX" } },
      "settings": { "expression": "41 - clamp(page + 1, 0, 3) * 332" },
      "ui": { "x": 40, "y": 340 }
    },
    "page_dots": {
      "type": "loop",
      "name": "Page Dots",
      "inputs": { "count": 4 },
      "ui": { "x": 40, "y": 40 }
    },
    "tap_next": {
      "type": "interaction",
      "name": "Tap Next",
      "inputs": { "layer": { "layer": "next_button" } },
      "ui": { "x": 40, "y": 190 }
    },
    "trip_price": {
      "type": "optionPicker",
      "name": "Trip Price",
      "typeParam": "text",
      "inputCount": 4,
      "inputs": {
        "option": { "link": "trips_scroll.pageX" },
        "option0": "$1,240",
        "option1": "$980",
        "option2": "$1,610",
        "option3": "$2,150"
      },
      "ui": { "x": 560, "y": 340 }
    },
    "trips_scroll": {
      "type": "scroll",
      "name": "Scroll Trips",
      "inputs": {
        "jumpPositionX": { "link": "next_page_x.output" },
