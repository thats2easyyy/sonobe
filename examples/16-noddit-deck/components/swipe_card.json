{
  "formatVersion": 1,
  "id": "swipe_card",
  "name": "Swipe Card",
  "kind": "patchComponent",
  "notes": "One card of the deck. Main runs it once per place: it gets the finger (Drag Card, Throw Card), the buttons and the card above it, and says where this copy goes, how it tilts and scales, what its badges show, and whether it's gone.",
  "interface": {
    "inputs": {
      "aboveLift": { "key": "aboveLift", "name": "Card Above Lift", "type": "number", "default": 1 },
      "aboveOffset": {
        "key": "aboveOffset",
        "name": "Card Above Offset",
        "type": "point",
        "default": [0, 0]
      },
      "cardAboveGone": { "key": "cardAboveGone", "name": "Card Above Gone", "type": "boolean", "default": true },
      "down": { "key": "down", "name": "Down", "type": "boolean", "default": false },
      "grabPoint": {
        "key": "grabPoint",
        "name": "Grab Point",
        "type": "point",
        "default": [0, 0]
      },
      "passHeld": { "key": "passHeld", "name": "Pass Held", "type": "boolean", "default": false },
      "passTapped": { "key": "passTapped", "name": "Pass Tapped", "type": "pulse" },
      "projected": {
        "key": "projected",
        "name": "Projected Throw",
        "type": "point",
        "default": [0, 0]
      },
      "reset": { "key": "reset", "name": "Reset", "type": "pulse" },
      "swipedLeft": { "key": "swipedLeft", "name": "Swiped Left", "type": "pulse" },
      "swipedRight": { "key": "swipedRight", "name": "Swiped Right", "type": "pulse" },
      "translation": {
        "key": "translation",
        "name": "Translation",
        "type": "point",
        "default": [0, 0]
      },
      "velocity": {
        "key": "velocity",
        "name": "Velocity",
        "type": "point",
        "default": [0, 0]
      },
      "yesHeld": { "key": "yesHeld", "name": "Yes Held", "type": "boolean", "default": false },
      "yesTapped": { "key": "yesTapped", "name": "Yes Tapped", "type": "pulse" }
    },
    "outputs": {
      "badgeScale": { "key": "badgeScale", "name": "Badge Scale", "type": "number", "link": "badge_scale.output" },
      "gone": { "key": "gone", "name": "Gone", "type": "boolean", "link": "card_gone.on" },
      "lift": { "key": "lift", "name": "Lift", "type": "number", "link": "lift.progress" },
      "passBadge": { "key": "passBadge", "name": "Pass Badge Opacity", "type": "number", "link": "pass_badge.output" },
      "position": { "key": "position", "name": "Position", "type": "point", "link": "card_spring.output" },
      "rotation": { "key": "rotation", "name": "Rotation", "type": "number", "link": "card_tilt.output" },
      "scale": { "key": "scale", "name": "Scale", "type": "number", "link": "card_scale.output" },
      "shown": { "key": "shown", "name": "Shown", "type": "boolean", "link": "shown.output" },
      "touchable": { "key": "touchable", "name": "Touchable", "type": "boolean", "link": "still_in_deck.output" },
      "yesBadge": { "key": "yesBadge", "name": "Yes Badge Opacity", "type": "number", "link": "yes_badge.output" }
    }
  },
  "layers": [],
  "patches": {
    "armed": {
      "type": "or",
