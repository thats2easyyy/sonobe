  "comments": [
    {
      "id": "section_badges",
      "text": "7 · BADGES · fade in with distance (Badge Fade Start, Badge Fade End), pop once letting go would vote (Commit Pop)",
      "rect": [0, 2560, 1407, 362],
      "color": "pink"
    },
    {
      "id": "section_buttons",
      "text": "2 · ✕ ♥ BUTTONS · holding previews the vote on the top card (Button Nudge), tapping throws it",
      "rect": [0, 300, 946, 382],
      "color": "pink"
    },
    {
      "id": "section_from_main",
      "text": "FROM MAIN · the finger, the buttons, and the card above this one",
      "rect": [-640, 0, 255, 430],
      "color": "gray"
    },
    {
      "id": "section_next_card",
      "text": "8 · NEXT CARD · Lift tells the card underneath how far to grow (Next Card Scale)",
      "rect": [0, 3100, 442, 318],
      "color": "green"
    },
    {
      "id": "section_shipped_app",
      "text": "9 · THE SHIPPED APP · with Card Flies Out off only the top card shows, the cards under it follow it, and the next place springs back from the finger",
      "rect": [0, 3458, 519, 316],
      "color": "yellow"
    },
    {
      "id": "section_spring",
      "text": "5 · ONE SPRING GETS IT THERE · starting at the finger's speed (Spring Response, Spring Damping)",
      "rect": [0, 1700, 1114, 506],
      "color": "green"
    },
    {
