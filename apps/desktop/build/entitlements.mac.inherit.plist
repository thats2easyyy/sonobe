<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime entitlements for everything inside Sonobe.app that isn't the app itself:
  electron-builder signs the helpers, the frameworks and Resources/bin/sfsymbol with this one file.
  It carries the camera and microphone keys too, because that includes the plain "Sonobe Helper",
  where Chromium runs its audio and video capture services.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
