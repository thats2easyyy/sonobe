{
  "name": "@sonobe/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/boot.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "start": "node scripts/build.mjs && electron . --mute-audio",
    "smoke": "node tests/smoke.mjs",
    "smoke:import": "node tests/import-smoke.mjs",
    "smoke:drafts": "node tests/drafts-smoke.mjs",
    "rehearse:update": "node tests/update-rehearsal.mjs",
    "bench:startup": "node tests/startup-bench.mjs",
    "test": "vitest run --config vitest.config.ts",
    "icons": "node scripts/icons.mjs",
    "package": "node scripts/package.mjs",
    "package:verify": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@anthropic-ai/sdk": "^0.126.0",
    "@sonobe/core": "*",
    "@sonobe/engine": "*",
    "@sonobe/import": "*",
    "@sonobe/mcp": "*",
    "@sonobe/patches": "*",
    "electron-updater": "6.8.9",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.0",
    "@types/ws": "^8.5.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thats2easyyy/sonobe.git"
  },
  "homepage": "https://github.com/thats2easyyy/sonobe",
  "bugs": {
    "url": "https://github.com/thats2easyyy/sonobe/issues"
  },
  "description": "Sonobe desktop app: open-source, AI-native interaction prototyping.",
  "author": "Sonobe contributors",
  "license": "MIT"
}
