{
  "manifest_version": 3,
  "name": "Sonobe Capture",
  "version": "0.1.0",
  "description": "Copy a web page or one element as a design, then paste it into Sonobe as real layers you can prototype.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture for Sonobe",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "offscreen", "clipboardWrite"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Open Sonobe Capture" },
    "pick-element": { "suggested_key": { "default": "Alt+Shift+E" }, "description": "Pick an element to copy for Sonobe" }
  }
}
